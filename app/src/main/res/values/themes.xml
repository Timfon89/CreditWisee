<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CreditWise" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_navy</item>
        <item name="colorPrimaryDark">@color/brand_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_emerald</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/brand_violet_tag</item>
        <item name="android:colorBackground">@color/surface_sunken_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOutlineVariant">#E1E7EE</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/surface_sunken_light</item>

        <item name="materialCardViewStyle">@style/Widget.CreditWise.Card</item>
    </style>

    <style name="Widget.CreditWise.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
