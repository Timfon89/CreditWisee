<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/Widget.CreditWise.MetricRow" android:orientation="horizontal">
            <TextView style="@style/Widget.CreditWise.MetricLabel" android:text="@string/result_final" />
            <TextView android:id="@+id/tvRating999" style="@style/Widget.CreditWise.MetricValue" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.CreditWise.MetricRow" android:orientation="horizontal">
            <TextView style="@style/Widget.CreditWise.MetricLabel" android:text="@string/result_external" />
            <TextView android:id="@+id/tvExternal" style="@style/Widget.CreditWise.MetricValue" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.CreditWise.MetricRow" android:orientation="horizontal">
            <TextView style="@style/Widget.CreditWise.MetricLabel" android:text="@string/result_behavior" />
            <TextView android:id="@+id/tvBehavior" style="@style/Widget.CreditWise.MetricValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:text="@string/result_factors"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/factorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:text="@string/result_recommendations"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/recommendationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardApplyAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:visibility="gone"
        app:cardBackgroundColor="@color/brand_emerald_tint">

        <TextView
            android:id="@+id/tvApplyAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/brand_emerald_deep" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
